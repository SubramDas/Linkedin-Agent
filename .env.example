# Google Gemini API Keys & Config
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODELS=gemini-3-flash-preview,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_CALL_DELAY_SECONDS=30.0

# Email Notification Settings (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SENDER_EMAIL=your_email@gmail.com
SENDER_APP_PASSWORD=your_gmail_app_password
RECEIVER_EMAIL=your_email@gmail.com

# GitHub Pages 1-Tap Mobile Copier URL
WEB_REVIEW_URL=https://yourusername.github.io/LinkedIn_posts/
